rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo accede a sus propias tareas.
    match /usuarios/{userId}/tareas/{tareaId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['titulo', 'creadaEn'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 200
        && request.resource.data.creadaEn == request.time;
    }

    // Todo lo demás queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
